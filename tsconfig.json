{
    "compilerOptions": {
        "strict": true,
        "noImplicitReturns": true,
        "noImplicitAny": true,
        "downlevelIteration": true,
        "module": "ES6",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES6",
        "jsx": "react-jsx",
        "jsxImportSource": "dom-renderer"
    },
    "include": ["./source/**/*"]
}
