{
    "name": "vcard-web",
    "version": "2.0.0",
    "license": "AGPL-3.0",
    "author": "shiy2008@gmail.com",
    "description": "vCard generator",
    "keywords": [
        "vcard",
        "generator",
        "web"
    ],
    "scripts": {
        "prepare": "husky",
        "clean": "rm -rf .parcel-cache/ dist/",
        "start": "npm run clean  &&  parcel source/index.html",
        "build": "npm run clean  &&  parcel build source/index.html --public-url .",
        "test": "lint-staged"
    },
    "lint-staged": {
        "*.{html,md,css,json,yml,js,ts}": "prettier --write"
    },
    "dependencies": {
        "dom-renderer": "^2.6.1",
        "mdui": "^2.1.3",
        "mobx": "^6.13.5",
        "mobx-restful": "^2.1.0-rc.1",
        "qrcode": "^1.5.4",
        "vcf": "^2.1.2",
        "web-cell": "^3.0.3"
    },
    "devDependencies": {
        "@parcel/config-default": "~2.13.2",
        "@parcel/packager-raw-url": "~2.13.2",
        "@parcel/transformer-typescript-tsc": "~2.13.2",
        "@parcel/transformer-webmanifest": "~2.13.2",
        "@types/qrcode": "^1.5.5",
        "@types/vcf": "^2.0.7",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.11",
        "parcel": "~2.13.2",
        "prettier": "^3.4.2",
        "typescript": "~5.7.2"
    },
    "prettier": {
        "tabWidth": 4,
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid"
    }
}
